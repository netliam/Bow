<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Self-hosted Grimmory servers are often plain http on a LAN.
	     NSAllowsLocalNetworking permits .local names, bare IPs and unqualified hostnames only;
	     public hosts still require HTTPS. See docs/architecture.md §8. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
